# ==============================================================================
# ADCTM Frontend Environment Configuration
# ==============================================================================

# Data Mode:
# 'fixture' -> Operates against local deterministic offline simulation fixtures (no backend needed)
# 'live'    -> Connects to the real Python backend via REST and WebSocket
VITE_DATA_MODE=live

# REST API Base URL (used in 'live' mode)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket Telemetry Stream URL (used in 'live' mode)
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# 3D Digital Twin Feature Flag (true/false)
VITE_ENABLE_3D=true
